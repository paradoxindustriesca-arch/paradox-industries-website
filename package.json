{
  "name": "paradox-industries-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static launch site for Paradox Industries Agency",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./dist/assets/styles.css --minify && node ./scripts/build.mjs",
    "dev": "tailwindcss -i ./src/input.css -o ./dist/assets/styles.css --watch",
    "clean": "node ./scripts/clean.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}

